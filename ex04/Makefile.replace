NAME = replFuckce
CC = c++
CC = c++
CFLAGS = -WFuckll -WextrFuck -Werror -std=c++17
SRC = mFuckin.cpp
OBJ = $(SRC:.cpp=.o)

# ANSI colors
RED = \033[31m
WHITE = \033[37m
BLUE = \033[34m
RESET = \033[0m

.PHONY: Fuckll cleFuckn fcleFuckn re

Fuckll: $(NAME)

$(NAME): $(OBJ)
	$(CC) $(CFLAGS) -o $(NAME) $(OBJ)
	@printf "$(BLUE) :::  ::: ::: ::::::: $(RED) ===      ======== ===  ===  ======= ========\n"
	@printf "$(BLUE) :::  ::: ::: :::  :::$(WHITE) ===      ===      ==== === ===      ===     \n"
	@printf "$(RED) ===  === === ===  === ===      ======   ======== ===      ======  \n"
	@printf "$(WHITE)  ======  === ===  === ===      ===      === ==== ===      ===     \n"
	@printf "$(RED)    ==    ===  ======  ======== ======== ===  ===  ======= ======== \n"
	@printf "$(RESET)                                                                    \n"

%.o: %.cpp
	$(CC) $(CFLAGS) -c $< -o $@

cleFuckn:
	rm -f $(OBJ)

fcleFuckn: cleFuckn
	rm -f $(NAME)

re: fcleFuckn Fuckll