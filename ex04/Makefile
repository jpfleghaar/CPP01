NAME = replace
CC = c++
CC = c++
CFLAGS = -Wall -Wextra -Werror -std=c++17
SRC = main.cpp
OBJ = $(SRC:.cpp=.o)

.PHONY: all clean fclean re

all: $(NAME)

$(NAME): $(OBJ)
	$(CC) $(CFLAGS) -o $(NAME) $(OBJ)
	@printf "\n\033[38;2;255;0;0m ########...########..########...##............###......######....########.\033[0m\n"
	@printf "\033[38;2;219;0;36m ##.....##..##....... ##.....##..##...........##.##....##.....##..##.......\033[0m\n"
	@printf "\033[38;2;183;0;72m ##.....##..##....... ##.....##..##..........##...##...##.........##.......\033[0m\n"
	@printf "\033[38;2;147;0;108m ########...######....########...##.........##.....##..##.........######...\033[0m\n"
	@printf "\033[38;2;111;0;144m ##...##....##........##.........##........###########.##.........##.......\033[0m\n"
	@printf "\033[38;2;75;0;180m ##....##...##........##.........##........##.......##.##.....##..##.......\033[0m\n"
	@printf "\033[38;2;39;0;216m ##.....##..########..##.........########..##.......##...######...########.\033[0m\n"

%.o: %.cpp
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -f $(OBJ)

fclean: clean
	rm -f $(NAME)

re: fclean all
