NAME = Harl
CC = c++
CFLAGS = -Wall -Wextra -Werror -std=c++17
SRC = main.cpp Harl.cpp
OBJ = $(SRC:.cpp=.o)

.PHONY: all clean fclean re fire

all: $(NAME)

$(NAME): $(OBJ)
	$(CC) $(CFLAGS) -o $(NAME) $(OBJ)
%.o: %.cpp
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -f $(OBJ)

fclean: clean
	rm -f $(NAME)

re: fclean all
